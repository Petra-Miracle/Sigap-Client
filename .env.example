# URL backend Sigap (tanpa garis miring di akhir). Lokal: http://localhost:4000, produksi: https://<backend>.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Opsional. Kosong = key & cluster diambil otomatis dari backend (GET /api/realtime/config).
# Hanya KEY publik Pusher; SECRET tidak pernah ditaruh di frontend.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
